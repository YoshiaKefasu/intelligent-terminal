<ContentPresenter x:Class="TerminalApp.TabRowControl"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mtu="using:Microsoft.Terminal.UI"
                  xmlns:mux="using:Microsoft.UI.Xaml.Controls"
                  Background="{ThemeResource TabViewBackground}"
                  mc:Ignorable="d">

    <!--
        GH#13143: Make sure that the Background is actually TabViewBackground
        here, not Transparent. This is load bearing, for showTabsInTitlebar=false.
    -->

    <!--
        Set the padding to -1 on the bottom. This prevents a small 1px gap that
        can appear on 150% scale displays between the tab item and the content.
        The 1 on top helps keep the tab the correct relative height within the
        tab row.
    -->

    <!--
        PROTOTYPE — see investigation-vertical-tabs.md. TabView (horizontal) and
        TabStrip (vertical) coexist; only one is visible at a time, driven by
        TabRowControl.IsVerticalLayout. Wrapping in a Grid preserves TabView's
        VerticalAlignment="Bottom" behavior.
    -->
    <Grid>

    <mux:TabView x:Name="TabView"
                 VerticalAlignment="Bottom"
                 HorizontalContentAlignment="Stretch"
                 AllowDropTabs="True"
                 Background="Transparent"
                 CanDragTabs="True"
                 CanReorderTabs="True"
                 IsAddTabButtonVisible="false"
                 TabWidthMode="Equal">

        <mux:TabView.TabStripHeader>
            <StackPanel x:Name="HorizontalChromeHeader"
                        Orientation="Horizontal">
                <!--  EA18 is the "Shield" glyph  -->
                <FontIcon x:Name="ElevationShieldIcon"
                          x:Uid="ElevationShield"
                          Margin="9,4,0,4"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          Glyph="&#xEA18;"
                          Visibility="{x:Bind ShowElevationShield, Mode=OneWay}" />

                <!--  Keep this button collapsed regardless of showWorkspacesButton until the workspace feature is generally available.  -->
                <Button x:Name="WorkspaceDropdown"
                        x:Uid="WorkspaceDropdown"
                        Margin="4,0,0,4"
                        Padding="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="Collapsed">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <!--  EE40 is the "TaskViewSettings" glyph  -->
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      Glyph="&#xEE40;" />
                            <TextBlock x:Name="WorkspaceNameText"
                                       Padding="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="{x:Bind WorkspaceName, Mode=OneWay}"
                                       Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(WorkspaceName), Mode=OneWay}" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout x:Name="WorkspaceFlyout" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </mux:TabView.TabStripHeader>

        <mux:TabView.TabStripFooter>
            <Grid x:Name="HorizontalChromeFooter">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <!--
                                Segmented chrome group: the two toggles below sit
                                flush against the new-tab SplitButton, so their
                                hover/pressed fill has to match it exactly. The
                                SplitButton's own ThemeDictionaries (further down)
                                map SplitButton* onto TabViewButton*, so mapping
                                Button* onto the same keys makes the whole run read
                                as one control instead of three unrelated squares —
                                and guarantees the match without hardcoding a color.

                                Safe at this scope: the SplitButton's template gives
                                its inner buttons their own ControlTemplate (a plain
                                RootGrid + ContentPresenter with only a Disabled
                                state), so they never read ButtonBackground*.
                            -->
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                ResourceKey="TabViewButtonBackgroundPointerOver" />
                                <StaticResource x:Key="ButtonBackgroundPressed"
                                                ResourceKey="TabViewButtonBackgroundPressed" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                ResourceKey="TabViewButtonBackgroundPointerOver" />
                                <StaticResource x:Key="ButtonBackgroundPressed"
                                                ResourceKey="TabViewButtonBackgroundPressed" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                ResourceKey="TabViewButtonBackgroundPointerOver" />
                                <StaticResource x:Key="ButtonBackgroundPressed"
                                                ResourceKey="TabViewButtonBackgroundPressed" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>

                        <!--
                            "Lit" fill for the session toggle. Same ARGB(30,255,255,255)
                            overlay the retired bottom bar used, kept as one static
                            brush instance: minting a fresh SolidColorBrush on every
                            state update is what made the chrome leave stale
                            composited patches on Acrylic windows (issue #1020; see
                            the brush-reuse fix in #1014).
                        -->
                        <SolidColorBrush x:Key="TabRowToggleLitBrush"
                                         Color="#1EFFFFFF" />
                        <!--
                            Matches WinUI 2's ControlCornerRadius. Spelled out
                            because only the *right* pair of corners is rounded
                            here; a CornerRadius resource cannot be partially
                            applied without a converter.
                        -->
                        <CornerRadius x:Key="TabRowGroupRightCornerRadius">0,4,4,0</CornerRadius>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Remove this border after WinUI 2.8  -->
                <Border Height="1"
                        VerticalAlignment="Bottom"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <mux:SplitButton x:Name="NewTabButton"
                                 x:Uid="NewTabSplitButton"
                                 Grid.Column="0"
                                 Height="24"
                                 Margin="0,4"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 AllowDrop="True"
                                 AutomationProperties.AccessibilityView="Control"
                                 BorderThickness="0"
                                 Click="OnNewTabButtonClick"
                                 Content="&#xE710;"
                                 DragOver="OnNewTabButtonDragOver"
                                 Drop="OnNewTabButtonDrop"
                                 FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                 FontSize="12">
                    <ToolTipService.ToolTip>
                        <ToolTip Placement="Mouse">
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Uid="NewTabRun" /> <LineBreak />
                                <Run x:Uid="NewPaneRun"
                                     FontStyle="Italic" /> <LineBreak />
                                <Run x:Uid="NewWindowRun"
                                     FontStyle="Italic" />
                            </TextBlock>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <!--  U+E710 is the fancy plus icon.  -->
                    <mux:SplitButton.Resources>
                        <!--  Override the SplitButton* resources to match the tab view's button's styles.  -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <x:Double x:Key="SplitButtonPrimaryButtonSize">31</x:Double>
                            <x:Double x:Key="SplitButtonSecondaryButtonSize">31</x:Double>
                        </ResourceDictionary>
                    </mux:SplitButton.Resources>
                </mux:SplitButton>

                <!--  Tab-row mirrors of the bottom bar's main toggles:
                      session list + file manager ("Show/Hide File Manager").
                      The old agent chat pane toggle was retired (DEBLOAT):
                      its button is now the sidebar toggle. Click handlers are
                      bound in TerminalPage::Create; lit state is mirrored in
                      TerminalPage::_UpdateBottomBarState.

                      These two buttons butt against the SplitButton with no
                      margin, so [ + | v | sessions | sidebar ] reads as one
                      segmented group. BorderThickness is 0 for the same reason
                      the SplitButton sets it: Button's PointerOver visual state
                      animates the template RootGrid's BorderBrush to
                      ButtonBorderBrushPointerOver, which would otherwise draw
                      a 1px box around each segment. The exact brush that key
                      resolves to belongs to the WinUI theme dictionary, not to
                      this file, so BorderThickness=0 is what actually guarantees
                      the segmented look across WinUI versions.

                      The session toggle is the middle segment, so it stays
                      square; only the sidebar toggle carries the rounded end.
                      That end is applied in code from the resolved flow
                      direction (TerminalPage::Create): CornerRadius does not
                      mirror with FlowDirection, so in RTL the sidebar button
                      sits on the physical left and needs the opposite pair.

                      Note: the SplitButton's template paints its fill in the
                      non-rounded Primary/SecondaryBackgroundGrids, so the left
                      end stays square unless that template is replaced (doing
                      so would break TabTests::NewTabButtonSharesChromeBackdrop).  -->
                <Button x:Name="SessionToggleTabRowButton"
                        Grid.Column="1"
                        Width="32"
                        Height="24"
                        Margin="0,4,0,4"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock x:Name="SessionToggleTabRowLabel"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           LineHeight="16" />
                                <TextBlock Text="Ctrl+Shift+/"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           Opacity="0.7" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Grid>
                        <!--
                            Lit state. Deliberately a sibling Border and not the
                            Button's own Background: the Button template paints its
                            fill through ContentPresenter.Background, which the
                            PointerOver/Pressed VisualStates animate. A brush written
                            into Button.Background becomes the revert target of those
                            storyboards, which on an Acrylic (HostBackdrop) window
                            leaves an opaque patch behind after the pointer leaves
                            (issue #1020). Toggled by _UpdateBottomBarState.
                        -->
                        <Border x:Name="SessionToggleTabRowLitBackground"
                                Background="{ThemeResource TabRowToggleLitBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Image Width="16"
                               Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///AgentIcons/session.svg"
                                                RasterizePixelWidth="32"
                                                RasterizePixelHeight="32" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Button>

                <!--  File manager (yazi split pane) open/close. Bound in
                      TerminalPage::Create to _ToggleGitSidebar; the same action
                      is reachable from the palette and from Ctrl+Shift+E.  -->
                <Button x:Name="SidebarToggleTabRowButton"
                        Grid.Column="2"
                        Width="32"
                        Height="24"
                        Margin="0,4,0,4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource TabRowGroupRightCornerRadius}">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Show/Hide File Manager"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           LineHeight="16" />
                                <!--  Filled in from TerminalPage with the
                                      effective binding of ToggleGitSidebar.  -->
                                <TextBlock x:Name="SidebarToggleTabRowShortcut"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           LineHeight="16"
                                           Opacity="0.7"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <!--  U+E8A0 is the panel / split-view "OpenPane" glyph.  -->
                    <FontIcon x:Name="SidebarToggleTabRowIcon"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16"
                              Glyph="&#xE8A0;"
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </Button>
            </Grid>
        </mux:TabView.TabStripFooter>

    </mux:TabView>

    <!--
        PROTOTYPE — visibility flipped by TabRowControl.IsVerticalLayout. The
        complete vertical chrome uses the titlebar when available, with
        TabStrip.TopChromeContent as its no-titlebar fallback.
    -->
    <local:TabStrip x:Name="TabStrip"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />

    </Grid>

</ContentPresenter>
